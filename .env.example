PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Required to enable doctor authentication. Use a long, random secret.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h
HOSPITAL_TIMEZONE=Asia/Kolkata
# Separate high-entropy key used only for one-time first-admin provisioning
STAFF_PROVISIONING_KEY=replace-with-a-separate-random-key-at-least-32-characters-long

# Admin-held key required to attach a login to an existing doctor record.
DOCTOR_REGISTRATION_KEY=replace-with-a-separate-random-registration-key

# MongoDB connection string. Keep real credentials in .env, never commit them.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
# Optional when the database name is not present in the URI
# MONGODB_DB_NAME=hospital

# Set to false only for in-memory automated tests
PERSIST_DB=true

# Seed settings: slots are generated for SEED_DAYS days starting at SEED_START_DATE (Sundays skipped)
SEED_START_DATE=2026-10-07
SEED_DAYS=14

# Optional destructive demo reset endpoint. Disabled unless explicitly enabled.
ENABLE_ADMIN_RESET=false
# Set a separate secret if enabling the reset endpoint
# ADMIN_RESET_TOKEN=replace-with-a-long-random-token
